{
  "name": "bidmaster-pro-desktop",
  "version": "2.0.5",
  "description": "智能招投标平台 - 全流程智能招投标平台",
  "main": "main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/anonymous99-Rise/BidMaster-Pro.git"
  },
  "author": {
    "name": "BidMaster Team",
    "email": "admin@bidmaster.pro"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:15168 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.bidmaster.pro",
    "productName": "智能招投标平台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "preload/**",
      "dist/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "anonymous99-Rise",
      "repo": "BidMaster-Pro",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "artifactName": "${name}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@tanstack/react-query": "^5.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-window": "^1.8.8",
    "axios": "^1.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-window": "^2.2.7",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^41.0.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "wait-on": "^7.2.0"
  }
}
